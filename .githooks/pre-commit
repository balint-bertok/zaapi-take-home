#!/usr/bin/env bash
# Fails closed: a missing scanner refuses the commit instead of silently skipping the scan.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (expected $(cat "$root/.gitleaks-version")); refusing to commit." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
