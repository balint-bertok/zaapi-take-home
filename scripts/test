#!/usr/bin/env bash
# Every test the project has, in the order that fails fastest. Called by scripts/gate (and so by CI).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "test: typecheck"; npm run --silent typecheck
echo "test: lint"; npm run --silent lint
echo "test: unit"; npm run --silent test:unit
echo "test: build"; npm run --silent build
echo "test: e2e against the built preview"; npm run --silent test:e2e
