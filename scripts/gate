#!/usr/bin/env bash
# Local gate. Same command CI runs, so a green gate here means a green CI job on the same tree.
# Fails closed on a missing scanner. Add the test command here once the stack is chosen.
set -euo pipefail
cd "$(dirname "$0")/.."

expected="$(cat .gitleaks-version)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gate: gitleaks is not installed (expected $expected); refusing." >&2
  exit 1
fi
installed="$(gitleaks version)"
if [ "$installed" != "$expected" ]; then
  echo "gate: gitleaks $installed installed, CI pins $expected; results may differ." >&2
fi

echo "gate: secret scan over full history"
gitleaks git --redact --no-banner --config .gitleaks.toml .

echo "gate: tests"
if [ -x scripts/test ]; then
  scripts/test
else
  echo "gate: WAIVED, no scripts/test yet (stack undecided as of 2026-10-01)"
fi
